# 复制为 keystore.properties 后填写真实值。
# keystore.properties 已被 .gitignore——绝不提交、绝不分享。
# storeFile 用 keystore 的绝对路径（例：D:/backup/band-health-sync-release.jks）。
# keystore 与密码必须与历史版本保持同一个，否则用户无法覆盖升级。
storeFile=/绝对路径/band-health-sync-release.jks
storePassword=你的store密码
keyAlias=band-health-sync
keyPassword=你的key密码
